# =============================================================================
# 01 — Azure Key Vault  (pairs with docs/KEYVAULT.md)
# =============================================================================
#
# ⚠️  LEARNING REFERENCE — read it, run it yourself when ready. Nothing here
#     runs automatically. Assumes $RG / $LOCATION / $SUFFIX are still set from
#     00-resource-group.azcli.
#
# -----------------------------------------------------------------------------
# THEORY — What Key Vault is and what these commands set up
# -----------------------------------------------------------------------------
# Key Vault is a managed "locked box" for secrets (API keys, connection
# strings, certificates). The app never stores a secret itself — at startup it
# asks the Vault "give me the secrets I'm allowed to read" and merges them into
# IConfiguration. See docs/KEYVAULT.md for the full theory + the IOptions
# consumer side.
#
# The provisioning story has THREE parts, and missing any one is the usual
# reason "it doesn't work in Azure":
#   1. Create the Vault.
#   2. Put secrets in it — using the `--` (double-dash) naming convention so
#      they map onto .NET's colon-separated config keys.
#   3. Give the APP an identity, and grant THAT identity read access to the
#      Vault. Without this, the app authenticates as "nobody" and gets denied.
# Part 3 depends on the Web App existing, so the identity+grant commands at the
# bottom are cross-referenced from 03-app-service.azcli — run them after the
# app exists.
# -----------------------------------------------------------------------------

KEYVAULT_NAME="kv-highfid-$SUFFIX"     # 3-24 chars, globally unique, alphanumerics + dashes

# --- 1. Create the Vault -----------------------------------------------------
# --enable-rbac-authorization true = use Azure RBAC (role assignments) for
# access instead of the older "access policies" model. RBAC is the modern,
# recommended approach: you grant an identity a ROLE ("Key Vault Secrets User")
# rather than hand-editing an access-policy list.
az keyvault create \
  --name "$KEYVAULT_NAME" \
  --resource-group "$RG" \
  --location "$LOCATION" \
  --enable-rbac-authorization true

# Grant YOURSELF permission to add secrets (your az login identity needs the
# "Key Vault Secrets Officer" role to write secrets under the RBAC model).
MY_OBJECT_ID=$(az ad signed-in-user show --query id -o tsv)
KV_ID=$(az keyvault show --name "$KEYVAULT_NAME" --query id -o tsv)
az role assignment create \
  --assignee "$MY_OBJECT_ID" \
  --role "Key Vault Secrets Officer" \
  --scope "$KV_ID"
# (RBAC assignments can take a minute to propagate — if the next step 403s,
#  wait 60s and retry.)

# --- 2. Add the secrets, using the -- naming convention ----------------------
# Secret name  "PaymentGateway--ApiKey"  ->  config key  "PaymentGateway:ApiKey"
# The Key Vault config provider does this `--` -> `:` translation automatically.
# These map to PaymentGatewayOptions.ApiKey / .ApiSecret in the app.
az keyvault secret set \
  --vault-name "$KEYVAULT_NAME" \
  --name "PaymentGateway--ApiKey" \
  --value "REPLACE-with-the-real-api-key"

az keyvault secret set \
  --vault-name "$KEYVAULT_NAME" \
  --name "PaymentGateway--ApiSecret" \
  --value "REPLACE-with-the-real-api-secret"

# --- 3. Grant the APP read access (run AFTER 03-app-service.azcli) -----------
# The Web App gets a system-assigned Managed Identity (see 03). That identity —
# not a password — is what the app uses to authenticate to the Vault via
# DefaultAzureCredential. Grant it the read-only "Key Vault Secrets User" role.
#
#   APP_NAME="app-highfid-$SUFFIX"
#   APP_MI_ID=$(az webapp identity show --name "$APP_NAME" --resource-group "$RG" --query principalId -o tsv)
#   az role assignment create \
#     --assignee "$APP_MI_ID" \
#     --role "Key Vault Secrets User" \
#     --scope "$KV_ID"

# --- 4. Point the app at the Vault -------------------------------------------
# The app only calls Key Vault when KeyVault:Uri is set (see Program.cs). In
# Azure, set it as an app setting (03-app-service.azcli does this). The URI:
az keyvault show --name "$KEYVAULT_NAME" --query properties.vaultUri -o tsv
# -> https://kv-highfid-<suffix>.vault.azure.net/
#    Set app setting  KeyVault__Uri = <that URI>   (double-underscore = ":" in
#    Azure app settings, same idea as the "--" convention for secret names).

# -----------------------------------------------------------------------------
# VERIFY (after the app is deployed + granted access + restarted):
#   GET https://<app>.azurewebsites.net/api/payment-gateway/config-snapshot
#   -> should return the (masked) ApiKey, proving the value came from the Vault.
# -----------------------------------------------------------------------------
